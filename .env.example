# Google Cloud Translation API Key for testing
# Get your API key from: https://cloud.google.com/translate/docs
GOOGLE_CLOUD_TRANSLATION_API_KEY=your-google-api-key-here

# DeepL API Key for testing
# Get your API key from: https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key-here

# OpenAI API Key for testing
# Get your API key from: https://platform.openai.com/api-keys
# Also works with OpenAI-compatible APIs (Claude, Gemini, etc.)
OPENAI_API_KEY=your-openai-api-key-here
