{
  "name": "discord-message-translator",
  "version": "1.3.0",
  "description": "Chrome Extension to translate Discord messages automatically",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "type-check": "wxt prepare && tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "discord",
    "translator",
    "translation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "daisyui": "^5.7.44",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.6.0"
}
